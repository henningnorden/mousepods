{
  "manifest_version": 3,
  "name": "MousePods head tracking",
  "version": "0.2.0",
  "description": "Look around 360° videos on YouTube (and other 360° sites) by turning your head with your AirPods. Needs MousePods running on this computer.",
  "homepage_url": "https://github.com/starman-tech/mousepods",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8737/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "MousePods",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["bridge.js"], "run_at": "document_start", "all_frames": true },
    { "matches": ["<all_urls>"], "js": ["page.js"], "run_at": "document_start", "all_frames": true, "world": "MAIN" }
  ]
}
