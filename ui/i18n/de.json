{
 "about.58_byte_block_shared_by_airpods_3_and_pr": "58-Byte-Block, gemeinsam bei AirPods 3 und Pro: Q15-Quaternion [20:26], Gyroskop [26:32] (~0,122 °/s pro Einheit), Beschleunigung [38:44], Schwerkraft [44:50] (~1000 = 1 g).",
 "about.airpods_pro_2_sensordatawx_protocol_prot": "AirPods Pro 2: Protokoll <i>SensorDataWX</i> (protobuf, <code>0x100000</code>) — ACTIVITY(14), dann DEVMOTION6(16).",
 "about.apple_remotehid_rtbuddy_channel_0x800_ea": "<b>Apple RemoteHID</b> (RTBuddy-Kanal <code>0x800</code>): Jeder Sensor ist ein virtuelles HID-Gerät. Unterpaket-Header u32: deviceID (7 Bit), Länge (10 Bit), Typ (3 Bit).",
 "about.findings": "Erkenntnisse",
 "about.hostconnect_00_gg_00_00_00_02_00_00_the": "<b>HostConnect</b> <code>00 gg 00 00 | 00 02 00 00</code> → die AirPods veröffentlichen ihre Sensoren (DeviceConnect + plist + HID-Deskriptor).",
 "about.l2cap_mtu_at_672_bytes_linux_default_air": "<b>L2CAP-MTU</b>: Bei 672 Byte (Linux-Standard) verbergen die AirPods 3 ihre Sensoren; bei <code>2582</code> (wie iOS) veröffentlichen sie <i>devmotion6, accel, gyro, cma, kadabra</i>.",
 "about.setreport_feature_1_report_interval_s_on": "<b>SetReport feature 1 = Report Interval (µs)</b> auf devmotion6 → Bewegungsdaten bis ~200 Hz.",
 "about.user_acceleration_38_44_gravity_removed": "<b>Nutzerbeschleunigung</b> [38:44] (ohne Schwerkraft, ~1000 = 1 g): Rauschen ≈ 0,02 g in Ruhe — sauber genug für den Gleiten-Modus mit Nullsetzen bei jedem Halt.",
 "about.what_we_learned_from_reverse_engineering": "Was wir beim Reverse Engineering gelernt haben — Details in REVERSE_ENGINEERING.md.",
